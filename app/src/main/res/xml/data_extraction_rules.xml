<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing is backed up. The account secret key lives in the Android keystore and
    is not extractable anyway; excluding the rest keeps a device-transfer image
    from carrying the user's relay permissions and identity off the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
